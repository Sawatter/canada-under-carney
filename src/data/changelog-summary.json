      "featuredItems": [
        {
          "type": "method",
          "headline": "Same-day milestones need evidence",
          "body": "A rule added yesterday rejected any project whose stage date matched the day it was referred, because that pattern had been hiding older approvals as new progress. A project can genuinely reach a stage on the day it is referred, so the rule now allows it when the record states the evidence for that order, and still rejects it when the date looks like a default.",
          "itemIndex": 1
        }
      ]
    }
